# ==============================================================================
# Supabase Configuration (Cloud Database & Storage)
# ==============================================================================
# Project URL from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Backend Server Secret:
# Use either SUPABASE_SERVICE_ROLE_KEY (standard) or SUPABASE_SECRET_KEY (modern naming).
# WARNING: Never expose this key in client-side code, Git, or browser bundles!
# It is used strictly on the FastAPI server to reliably write predictions and manage storage.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_SECRET_KEY=

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_IMAGES=crop-images
SUPABASE_STORAGE_BUCKET_MASKS=segmentation-masks

# Signed URL expiration in seconds (default: 3600 = 1 hour)
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=3600

# Primary Database Strategy: "supabase" (default when configured) or "sqlite" (local fallback)
DATABASE_BACKEND=supabase

# ==============================================================================
# Local Server Configuration
# ==============================================================================
DEFAULT_MODEL=deeplabv3plus
IMAGE_SIZE=256
UPLOAD_DIR=backend/uploads
STATIC_DIR=backend/static
